# Copier ce fichier en .env puis renseigner des valeurs robustes.
# Le fichier .env est exclu du dépôt (.gitignore).

STACK_VERSION=8.11.4
CLUSTER_NAME=elk-secure-cluster

# Superutilisateur "elastic"
ELASTIC_PASSWORD=changeme_mot_de_passe_robuste

# Compte de service restreint utilisé par Kibana
KIBANA_SYSTEM_PASSWORD=changeme_mot_de_passe_systeme

# Clé de chiffrement des objets sauvegardés Kibana (32 caractères minimum)
KIBANA_ENCRYPTION_KEY=changeme_cle_aleatoire_de_32_caracteres_min

# Mémoire JVM par nœud
ES_JAVA_OPTS=-Xms1g -Xmx1g

# Adresse de l'hôte central (Elasticsearch / Kibana / Fleet Server)
ELK_HOST=192.168.56.51

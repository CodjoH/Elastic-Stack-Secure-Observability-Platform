# copier en .env et remplir (le .env n'est pas versionné)

ELASTIC_PASSWORD=
KIBANA_SYSTEM_PASSWORD=

# clés de chiffrement Kibana (32 caractères min.) : openssl rand -hex 32
KIBANA_ESO_KEY=
KIBANA_SECURITY_KEY=
KIBANA_REPORTING_KEY=

# chemins sur l'hôte
CERTS_DIR=/chemin/vers/certs/runtime
SNAPSHOTS_DIR=/chemin/vers/snapshots

# utilisé par les scripts de test
ELK_HOST=

# clé API Kibana (Stack Management > API keys) pour deploy-rules.py, build-dashboard.py
# et les tests de détection ; SOC_IR_API_KEY sert uniquement à l'installation de SOC-IR
KIBANA_API_KEY=
SOC_IR_API_KEY=

# tests/detection/simulate-attacks.sh : hôte Linux surveillé (cible des attaques simulées)
TARGET_HOST=

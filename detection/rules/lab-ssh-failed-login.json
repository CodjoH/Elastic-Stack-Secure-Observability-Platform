{
  "rule_id": "lab-ssh-failed-login",
  "name": "SSH - Échec d'authentification",
  "description": "Tentative de connexion SSH échouée (mauvais mot de passe ou utilisateur invalide).",
  "type": "query",
  "language": "kuery",
  "index": [
    "logs-system.auth-*"
  ],
  "query": "event.dataset:\"system.auth\" and event.action:\"ssh_login\" and event.outcome:\"failure\"",
  "severity": "medium",
  "risk_score": 47,
  "interval": "1m",
  "from": "now-2m",
  "enabled": true,
  "tags": [
    "SOC-Lab",
    "Linux",
    "Authentication"
  ],
  "author": [
    "CodjoH"
  ],
  "license": "MIT",
  "max_signals": 100,
  "threat": [
    {
      "framework": "MITRE ATT&CK",
      "tactic": {
        "id": "TA0006",
        "name": "Credential Access",
        "reference": "https://attack.mitre.org/tactics/TA0006/"
      },
      "technique": [
        {
          "id": "T1110",
          "name": "Brute Force",
          "reference": "https://attack.mitre.org/techniques/T1110/"
        }
      ]
    }
  ]
}
